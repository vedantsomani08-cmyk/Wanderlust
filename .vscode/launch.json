{
  // Press F5 in VS Code to build and run the website.
  // Needs the "C# Dev Kit" extension (it installs the C# extension too).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Wanderlust (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      // If you changed TargetFramework to net8.0, change net10.0 below too
      "program": "${workspaceFolder}/bin/Debug/net10.0/Wanderlust.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      }
    }
  ]
}
