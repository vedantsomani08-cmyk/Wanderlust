<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- If you only have the .NET 8 SDK installed, change this to net8.0 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wanderlust</RootNamespace>
    <!-- Lets you keep the API key out of appsettings.json during development -->
    <UserSecretsId>wanderlust-college-project</UserSecretsId>
  </PropertyGroup>

</Project>
